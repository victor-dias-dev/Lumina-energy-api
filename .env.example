GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_LAYOUT=default

# SQLite (local development). Used when DATABASE_URL is not a postgres URL.
DATABASE_PATH=./data/energy_bills.sqlite

# PostgreSQL (production, for example Render)
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_SSL=false

# Comma-separated browser origins. Default: http://localhost:3000
# CORS_ORIGIN=http://localhost:3000

# When set, POST /bills/upload requires the x-api-key header.
# API_KEY=

# Swagger is on outside production unless this is false. In production the default is off.
# SWAGGER_ENABLED=true

# Upload rate limit (requests per window, window in milliseconds)
# UPLOAD_RATE_LIMIT=10
# UPLOAD_RATE_TTL_MS=60000

NODE_ENV=development
PORT=3000
