GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash  # opcional: modelo preferido (fallback automático em 503)

# SQLite (desenvolvimento local) - use DATABASE_PATH
DATABASE_PATH=./data/energy_bills.sqlite

# PostgreSQL (produção, ex: Render) - use DATABASE_URL
# DATABASE_URL=postgresql://user:password@host:5432/database

NODE_ENV=development
